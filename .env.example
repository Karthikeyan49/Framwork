# Copy to .env or run make env. Values are development-only and never committed.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
# Access API DB transactions only; integer 1..10, default3. Pool remains10.
API_DB_CONCURRENCY=3
LOG_LEVEL=info
DATABASE_URL=
WORKER_DATABASE_URL=
DISPATCHER_DATABASE_URL=
WORKER_DB_PASSWORD=
DISPATCHER_DB_PASSWORD=
MIGRATION_DATABASE_URL=
REDIS_URL=
EVENTS_ENABLED=false
# M9 preview workflow execution; production rejects true. Dev/test default: true.
WORKFLOWS_ENABLED=false
EVENT_SENDER_REDIS_URL=
EVENT_RECEIVER_REDIS_URL=
EVENT_SENDER_PASSWORD=
EVENT_RECEIVER_PASSWORD=
EVENT_OPERATOR_REDIS_URL=
EVENT_OPERATOR_PASSWORD=
# EVENT_REDIS_URL is injected per process from its dedicated sender/receiver URL.
POSTGRES_PASSWORD=
MIGRATOR_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
VITE_API_BASE_URL=/api
# Development defaults below. Production requires explicit HTTPS issuer,
# API audience, and an operator-managed public JWKS; never deploy local keys.
AUTH_ISSUER=http://localhost:8080/dev-issuer
AUTH_AUDIENCE=framework-api
AUTH_JWKS_FILE=.local/identity/jwks.json
# Optional verifier clock tolerance: whole seconds, 0s–120s; never extends
# the one-hour signed token lifetime limit. Keep hosts synchronized.
AUTH_CLOCK_SKEW=0s
# Optional public-client OIDC code + S256 PKCE sign-in. Leave all five fields
# blank to disable; enabled providers default to the openid scope.
# Production endpoints/callback require HTTPS. Register the exact same-origin
# callback https://<web-origin>/auth/callback with your provider.
OIDC_CLIENT_ID=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_REDIRECT_URI=
OIDC_SCOPES=
# API-only flow store, separate from cache/event credentials. Local make env
# provisions a random credential; use secret management and verified TLS in prod.
SIGNIN_REDIS_URL=
SIGNIN_PASSWORD=
