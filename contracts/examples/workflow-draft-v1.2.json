{
  "schema_version": "1.2.0",
  "app_id": "app.workflows",
  "namespace": "example.contacts",
  "base_version": null,
  "definitions": [
    {
      "id": "entity.contact",
      "schema_version": "1.2.0",
      "namespace": "example.contacts",
      "label": "Contact",
      "kind": "entity",
      "entity": {
        "fields": [
          "field.contact.id",
          "field.contact.name",
          "field.contact.parent",
          "field.contact.status",
          "field.contact.balance",
          "field.contact.joined"
        ]
      }
    },
    {
      "id": "field.contact.id",
      "schema_version": "1.2.0",
      "namespace": "example.contacts",
      "label": "Identifier",
      "kind": "field",
      "field": {
        "entity_ref": "entity.contact",
        "type": "string",
        "required": true
      }
    },
    {
      "id": "field.contact.name",
      "schema_version": "1.2.0",
      "namespace": "example.contacts",
      "label": "Name",
      "kind": "field",
      "field": {
        "entity_ref": "entity.contact",
        "type": "string",
        "required": true
      }
    },
    {
      "id": "field.contact.parent",
      "schema_version": "1.2.0",
      "namespace": "example.contacts",
      "label": "Parent",
      "kind": "field",
      "field": {
        "entity_ref": "entity.contact",
        "type": "reference",
        "required": false,
        "reference_to": "entity.contact"
      }
    },
    {
      "id": "page.contact.edit",
      "schema_version": "1.2.0",
      "namespace": "example.contacts",
      "label": "Contact editor",
      "kind": "page",
      "page": {
        "entity_ref": "entity.contact",
        "components": [
          {
            "type": "section",
            "label": "Contacts",
            "children": [
              {
                "type": "form",
                "children": [
                  {
                    "type": "text_input",
                    "field_ref": "field.contact.name",
                    "label": "Name"
                  },
                  {
                    "type": "select",
                    "field_ref": "field.contact.status",
                    "label": "Status"
                  },
                  {
                    "type": "money_input",
                    "field_ref": "field.contact.balance",
                    "label": "Balance"
                  },
                  {
                    "type": "date_input",
                    "field_ref": "field.contact.joined",
                    "label": "Joined"
                  },
                  {
                    "type": "relation_picker",
                    "field_ref": "field.contact.parent",
                    "label": "Parent contact"
                  }
                ]
              },
              {
                "type": "table",
                "entity_ref": "entity.contact"
              },
              {
                "type": "detail",
                "entity_ref": "entity.contact"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "rule.contact.named",
      "schema_version": "1.2.0",
      "namespace": "example.contacts",
      "label": "Named contact",
      "kind": "rule",
      "rule": {
        "entity_ref": "entity.contact",
        "result_type": "bool",
        "expression": {
          "op": "neq",
          "args": [
            {
              "op": "field",
              "field_ref": "field.contact.name"
            },
            {
              "op": "literal",
              "value": ""
            }
          ]
        },
        "dsl_version": "2.0.0"
      }
    },
    {
      "schema_version": "1.2.0",
      "namespace": "example.contacts",
      "kind": "field",
      "id": "field.contact.status",
      "label": "Status",
      "field": {
        "entity_ref": "entity.contact",
        "type": "enum",
        "required": false,
        "enum_values": [
          "active",
          "inactive"
        ]
      }
    },
    {
      "schema_version": "1.2.0",
      "namespace": "example.contacts",
      "kind": "field",
      "id": "field.contact.balance",
      "label": "Balance",
      "field": {
        "entity_ref": "entity.contact",
        "type": "money",
        "required": false,
        "currency": "USD"
      }
    },
    {
      "schema_version": "1.2.0",
      "namespace": "example.contacts",
      "kind": "field",
      "id": "field.contact.joined",
      "label": "Joined",
      "field": {
        "entity_ref": "entity.contact",
        "type": "date",
        "required": false
      }
    },
    {
      "id": "relationship.contact.parent",
      "schema_version": "1.2.0",
      "namespace": "example.contacts",
      "label": "Parent contact",
      "kind": "relationship",
      "relationship": {
        "from_entity": "entity.contact",
        "to_entity": "entity.contact",
        "from_field": "field.contact.parent",
        "to_field": "field.contact.id",
        "cardinality": "many_to_one"
      }
    },
    {
      "id": "workflow.contact.review",
      "schema_version": "1.2.0",
      "namespace": "example.contacts",
      "label": "Contact review",
      "kind": "workflow",
      "workflow": {
        "dsl_version": "2.0.0",
        "version": "1.0.0",
        "timeout_ms": 60000,
        "entity_ref": "entity.contact",
        "trigger": "manual",
        "initial_state": "state.start",
        "states": [
          {
            "id": "state.start",
            "type": "start",
            "transitions": [
              {
                "to": "state.activity",
                "condition": {
                  "op": "eq",
                  "args": [
                    {
                      "op": "field",
                      "field_ref": "field.contact.status"
                    },
                    {
                      "op": "literal",
                      "value": "active"
                    }
                  ]
                }
              },
              {
                "to": "state.failed"
              }
            ]
          },
          {
            "id": "state.activity",
            "type": "activity",
            "activity": {
              "local_ref": "local.noop",
              "version": "1.0.0",
              "timeout_ms": 500,
              "retry": {
                "max_attempts": 3,
                "initial_backoff_ms": 100,
                "max_backoff_ms": 1000
              },
              "compensation_local_ref": "local.noop"
            },
            "transitions": [
              {
                "to": "state.timer"
              }
            ]
          },
          {
            "id": "state.timer",
            "type": "timer",
            "timer_ms": 100,
            "transitions": [
              {
                "to": "state.approval"
              }
            ]
          },
          {
            "id": "state.approval",
            "type": "approval",
            "approval_roles": [
              "admin",
              "owner"
            ],
            "approval_timeout_ms": 30000,
            "transitions": [
              {
                "to": "state.complete",
                "on": "approved"
              },
              {
                "to": "state.failed",
                "on": "rejected"
              }
            ]
          },
          {
            "id": "state.complete",
            "type": "complete",
            "transitions": []
          },
          {
            "id": "state.failed",
            "type": "failed",
            "transitions": []
          }
        ]
      }
    }
  ]
}
