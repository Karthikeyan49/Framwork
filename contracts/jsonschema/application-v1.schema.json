              "const": "1.0.0"
            },
            "namespace": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "kind": {
              "const": "field"
            },
            "field": {
              "$ref": "#/$defs/field"
            }
          },
          "required": [
            "id",
            "schema_version",
            "namespace",
            "label",
            "kind",
            "field"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
