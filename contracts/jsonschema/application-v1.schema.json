            },
            "namespace": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "kind": {
