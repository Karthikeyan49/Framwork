            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "kind": {
              "const": "page"
            },
            "page": {
              "$ref": "#/$defs/page"
            }
          },
          "required": [
            "id",
            "schema_version",
            "namespace",
            "label",
            "kind",
            "page"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 160,
              "pattern": "^rule\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
            },
            "schema_version": {
              "const": "1.0.0"
            },
            "namespace": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "kind": {
              "const": "rule"
